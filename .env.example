# Copy to .env.local and fill in. Never commit real keys.

# Resend API key with FULL ACCESS (a "sending access" key can't create contacts).
RESEND_API_KEY=

# ID of the Resend segment that is your waitlist list.
RESEND_SEGMENT_ID=

# Without RESEND_API_KEY, local dev saves sign-ups to data/waitlist.json instead.

# Site
NEXT_PUBLIC_SITE_URL=https://invoicedodo.com
# Optional: e.g. @invoicedodo, and the Google Search Console verification token
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Prismic (blog)
NEXT_PUBLIC_PRISMIC_REPOSITORY_NAME=invoicedodo
# Only needed if the repository's API is set to private
PRISMIC_ACCESS_TOKEN=
